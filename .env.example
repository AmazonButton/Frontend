# Backend API URL (for Production, e.g. https://your-backend.onrender.com)
VITE_API_URL=https://backend-fae8.onrender.com
VITE_BACKEND_URL=https://backend-fae8.onrender.com
VITE_SOCKET_URL=https://backend-fae8.onrender.com

# Goong REST API key for address lookup. Map Tiles key is separate and optional (OSM fallback).
VITE_GOONG_API_KEY=
VITE_GOONG_MAPTILES_KEY=

# Google OAuth Web application Client ID (not the Goong Maps API key).
VITE_GOOGLE_CLIENT_ID=
