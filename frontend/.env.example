# Backend API URL (for Production, e.g. https://your-backend.onrender.com)
VITE_API_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
VITE_GOOGLE_CLIENT_ID=

# Goong REST API key for address lookup. Map Tiles key is separate and optional (OSM fallback).
VITE_GOONG_API_KEY=
VITE_GOONG_MAPTILES_KEY=
